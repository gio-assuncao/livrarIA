# LLM via OpenRouter (OpenAI-compatible). Required for the chat.
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-3.5-haiku

# Optional — Google Books works without a key (lower rate limits)
GOOGLE_BOOKS_API_KEY=

# Optional overrides
# SQLITE_URL=sqlite:///./livrarIA.db
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
